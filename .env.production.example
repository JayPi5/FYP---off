# Backend runtime controls (production baseline)
SMOKWIT_STARTUP_STRICT=1
SMOKWIT_METRICS_API_KEY_REQUIRED=1
SMOKWIT_ADMIN_API_KEY=replace-with-long-random-secret

# Business calibration
SMOKWIT_STATS_WINDOW_HOURS=8
SMOKWIT_HELP_TARGET_POINTS_8H=100
SMOKWIT_SCAN_PERCENT_PER_SCAN=5

# Data quality / anti-noise
SMOKWIT_HELP_EVENT_DEDUPE_SECONDS=20
SMOKWIT_QR_SCAN_COOLDOWN_SECONDS=10

# Abuse protection
SMOKWIT_RATE_LIMIT_WINDOW_SECONDS=60
SMOKWIT_RATE_LIMIT_HELP_EVENT_PER_WINDOW=60
SMOKWIT_RATE_LIMIT_QR_PER_WINDOW=120

